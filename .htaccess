# =====================================================================
# .htaccess - SISGESNOM
# =====================================================================

# ----- SOLUCIÓN FORZADA -----
Options -Indexes

# Si existe index.php se sirve; si NO existe, se sirve no-index.php
DirectoryIndex index.php no-index.php

# Error 404 -> 404.php (recurso no encontrado)
ErrorDocument 404 /servicios/404.php

# Error 403 -> 403.php (acceso denegado)
ErrorDocument 403 /servicios/403.php

# =====================================================================
# ESTRUCTURA DEL SITIO
#   /              -> landing publico (index.php de la raiz)
#   /servicios/... -> sistema completo (portada, nominas, facturacion...)
#
# Las URLs antiguas (sin /servicios/) se redirigen para que los enlaces ya
# guardados en marcadores, plantillas y codigo no dejen de funcionar.
# =====================================================================
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Carpetas del sistema que se movieron a servicios/
    RewriteRule ^(assets|css|js|images|lib|Documentos|fcostoAdhesivo|fcostoCharangon|InstalarBD|facturacion|nominas|phpinfo)(/.*)?$ /servicios/$1$2 [R=301,L,NC]

    # Paginas sueltas del sistema
    RewriteRule ^(403|404|no-index|contacto|correo_privado|explorer|sg|privacidad|soporte|terminos)\.php$ /servicios/$1.php [R=301,L,NC]
</IfModule>

# =====================================================================
# SEGURIDAD - Bloquear archivos sensibles
# =====================================================================

# 1) Bloquear el token de la herramienta (nombre exacto)
<FilesMatch "^\.tool_token$">
    Require all denied
</FilesMatch>

# 2) Bloquear cualquier archivo que empiece por punto
#    (.tool_token, .htaccess, .env, .git, .tool_token.bak, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# 3) Bloquear extensiones de backup / temporales del token
<FilesMatch "\.tool_token$|\.tool_token\..*$">
    Require all denied
</FilesMatch>

# 4) Bloquear archivos .lic exportados (contienen datos de licencia)
<FilesMatch "\.lic$">
    Require all denied
</FilesMatch>

# 5) Bloquear la carpeta de licencias exportadas (por si existe)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^licencias_exportadas/ - [F,L]
</IfModule>