<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99050B14"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_offline_card"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_offline_icon"
                android:padding="10dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/app_name"
                    android:scaleType="fitCenter"
                    android:src="@mipmap/ic_launcher_round" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/updateTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Actualizaci?n disponible"
                    android:textColor="#FFFFFF"
                    android:textSize="21sp" />

                <TextView
                    android:id="@+id/updateVersions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="v1.0.0 ? v1.0.1"
                    android:textColor="#C084FC"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnUpdateClose"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="Cerrar"
                android:padding="6dp"
                android:src="@drawable/ic_close"
                android:tint="#9FB3C8" />
        </LinearLayout>

        <TextView
            android:id="@+id/updateSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="3dp"
            android:textColor="#B8C7D9"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/updateMetaRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/updateSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_update_chip"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:textColor="#9ADCF0"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/updateDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_update_chip"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:textColor="#9ADCF0"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/updateRequired"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-medium"
            android:text="Esta actualizaci?n es necesaria para continuar."
            android:textColor="#FCA5A5"
            android:textSize="13sp"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/updateChangesScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fillViewport="false"
            android:maxHeight="220dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/updateChangesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <TextView
            android:id="@+id/updateMinSupported"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnUpdateDownload"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_offline_button"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:text="Descargar actualizaci?n"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnUpdateNotes"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_offline_button_secondary"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Ver novedades"
            android:textColor="#EAF2FA"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnUpdateVersions"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_update_versions_button"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Control de versiones"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/updateSecondaryRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnUpdateLater"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_offline_button_secondary"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="M?s tarde"
                android:textColor="#C9D8E6"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnUpdateSkip"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_offline_button_secondary"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="Omitir versi?n"
                android:textColor="#C9D8E6"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
